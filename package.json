{
  "name": "bmsui-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/*/demo",
    "docs-site"
  ],
  "scripts": {
    "build": "bun run --filter '@bmsuisse/datagrid' --filter '@bmsuisse/ui' build",
