{
  "name": "@bmsuisse/ui",
  "version": "0.31.0",
  "description": "Shared shadcn/ui-based React primitives, composed UI patterns (dialogs, forms, inputs, date picking, feedback, page layout, command palette) and hooks. See CATALOG.md for the full list.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmsuisse/bmsui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/bmsuisse/bmsui/tree/main/packages/ui#readme",
  "bugs": "https://github.com/bmsuisse/bmsui/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CATALOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "playwright test -c visual/playwright.config.ts",
    "test:visual:update": "playwright test -c visual/playwright.config.ts --update-snapshots=missing"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@heroicons/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
